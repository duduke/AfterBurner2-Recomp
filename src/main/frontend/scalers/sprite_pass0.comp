// Generated from the CPU reference. ScaleFX MIT notice is retained in scalefx.hpp.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Input { uint data[]; } src;
layout(set=1,binding=1,std430) buffer Intermediate { vec4 data[]; } fx;
layout(set=1,binding=0,rgba8) uniform writeonly image2D output_image;
layout(set=2,binding=0,std140) uniform Params { int w; int h; int mode; int factor; } p;
// Refine reciprocal division with an explicit fused residual. Metal's
// approximate constant division otherwise changes ScaleFX's exact tie decisions.
float divround(float a,float b) { precise float q=a/b; precise float e=fma(-q,b,a); return fma(e,1.0/b,q); }
vec4 divround(vec4 a,float b) { return vec4(divround(a.x,b),divround(a.y,b),divround(a.z,b),divround(a.w,b)); }
uint pixel(int x,int y,int w,int h) { return src.data[w*h+clamp(y,0,h-1)*w+clamp(x,0,w-1)]; }
vec4 LE(vec4 x,vec4 y){return 1.f-step(y,x);}
vec4 GE(vec4 x,vec4 y){return 1.f-step(x,y);}
float GE(float x,float y){return x>y?1.f:0.f;}
vec4 LEQ(vec4 x,vec4 y){return step(x,y);}
vec4 NOT(vec4 x){return 1.f-x;}
float NOT(float x){return 1.f-x;}
float dist(uint a,uint b){
 if ((a>>24)!=(b>>24)) return 1.f;
 const float ar=divround(float(((a>>16)&255)),255.f),br=divround(float(((b>>16)&255)),255.f);
 const float r=(ar+br)*.5f, dr=ar-br;
 const float dg=divround(float(int((a>>8)&255)-int((b>>8)&255)),255.f);
 const float db=divround(float(int(a&255)-int(b&255)),255.f);
 return divround(sqrt((2.f+r)*dr*dr+4.f*dg*dg+(3.f-r)*db*db),3.f);
}
int index(int x,int y,int w,int h){return clamp(y,0,h-1)*w+clamp(x,0,w-1);}
float str(float d,vec2 a,vec2 b){
 const float diff=a.x-a.y,wght1=max(.5f-d,0.f)/.5f;
 const float wght2=clamp((1.f-d)+(min(a.x,b.x)+a.x>min(a.y,b.y)+a.y?diff:-diff),0.f,1.f);
 return (wght1*wght2)*(a.x*a.y);
}
vec4 dom(vec3 x, vec3 y, vec3 z, vec3 w){
	return 2.f * vec4(x.y, y.y, z.y, w.y) - (vec4(x.x, y.x, z.x, w.x) + vec4(x.z, y.z, z.z, w.z));
}

// necessary but not sufficient junction condition for orthogonal edges
float clear(vec2 crn, vec2 a, vec2 b){
	return (crn.x >= max(min(a.x, a.y), min(b.x, b.y))) && (crn.y >= max(min(a.x, b.y), min(b.x, a.y))) ? 1.f : 0.f;
}

vec4 loadCorn(vec4 x){
	return vec4(floor(mod(x*15.f + 0.5f, 2.f)));
}

// extract second bool4 from float4 - horizontal edges
vec4 loadHori(vec4 x){
	return vec4(floor(mod(x*7.5f + 0.25f, 2.f)));
}

// extract third bool4 from float4 - vertical edges
vec4 loadVert(vec4 x){
	return vec4(floor(mod(x*3.75f + 0.125f, 2.f)));
}

// extract fourth bool4 from float4 - orientation
vec4 loadOr(vec4 x){
	return vec4(floor(mod(x*1.875f + 0.0625f, 2.f)));
}


uint simple(int x,int y,int sx,int sy,int w,int h,int mode) {
 if(mode==0)return pixel(x,y,w,h);
 uint E=pixel(x,y,w,h),B=pixel(x,y-1,w,h),D=pixel(x-1,y,w,h),F=pixel(x+1,y,w,h),H=pixel(x,y+1,w,h);
 if(B==H || D==F) return E;
 if(mode==1) { if(sy==0)return sx==0?(D==B?D:E):(B==F?F:E); return sx==0?(D==H?D:E):(H==F?F:E); }
 uint A=pixel(x-1,y-1,w,h),C=pixel(x+1,y-1,w,h),G=pixel(x-1,y+1,w,h),I=pixel(x+1,y+1,w,h);
 uint q[9]=uint[9](D==B?D:E,((D==B && E!=C)||(B==F && E!=A))?B:E,B==F?F:E,
 ((D==B && E!=G)||(D==H && E!=A))?D:E,E,((B==F && E!=I)||(H==F && E!=C))?F:E,
 D==H?D:E,((D==H && E!=I)||(H==F && E!=G))?H:E,H==F?F:E);
 return q[sy*3+sx];
}

void main(){
int x=int(gl_GlobalInvocationID.x),y=int(gl_GlobalInvocationID.y),w=p.w,h=p.h; if(x>=w || y>=h)return;
{

  uint E=pixel(x,y,w,h);
  fx.data[y*w+x+0*p.w*p.h]=vec4(dist(E,pixel(x-1,y-1,w,h)),dist(E,pixel(x,y-1,w,h)),
                     dist(E,pixel(x+1,y-1,w,h)),dist(E,pixel(x+1,y,w,h)));

}
}
