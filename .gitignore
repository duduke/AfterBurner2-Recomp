# Build output
build/
out/
cmake-build-*/
*.o
*.d
/afterburner2
/afterburner2.exe

# Original arcade ROM data (copyrighted, not redistributable)
roms/*.zip
roms/*.bin
roms/*.rom
roms/epr-*
roms/mpr-*
roms/opr-*
!roms/roms.txt
!roms/README.md

# OS / editor cruft
.DS_Store
*.swp
.vscode/
.idea/

# Three.js is branch-only; retain local dependencies/caches without tracking them.
/prototypes/threejs/
# Python validation-tool caches.
__pycache__/

# Optional librashader's generated shader-object cache (Windows).
/librashader/

# User-provided replacement music
/soundtrack/

# Android local toolchain, Gradle caches and private signing configuration.
/android/.gradle/
/android/.cxx/
/android/app/.cxx/
/android/app/build/
/android/local.properties
*.keystore
*.jks
